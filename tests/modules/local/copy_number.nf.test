nextflow_process {

    name "Test Process COPY_NUMBER"
    script "modules/local/copy_number.nf"
    process "COPY_NUMBER"

test("Should execute copy_number.nf and create output") {
       
        
      when {
    process {
        """
        input[0] = file("\${projectDir}/test-data/input_copy_number/coverage_summary.tsv")
        input[1] = file("\${projectDir}/modules/local/R_scripts/copy_number.R")
        """
    }
}


        then {
            assert process.success

            // global automated test
            assert snapshot(process.out).match()

            // checks if output file exists
            assert path(process.out.results[0]).exists()


        }

    }

test("Should group BED files by type and not by file name") {

      when {
    process {
        """
        input[0] = file("\${projectDir}/test-data/input_copy_number/coverage_summary_custom_names.tsv")
        input[1] = file("\${projectDir}/modules/local/R_scripts/copy_number.R")
        """
    }
}

        then {
            assert process.success

            def rows = path(process.out.results[0]).readLines()
            def header = rows[0].split("\t").toList()
            def cne = header.indexOf("cne_vntr")

            assert header == ["sample", "gene-a-1.bed", "gene-a-2.bed", "repeat-b-1.bed", "repeat-b-2.bed", "nonrep_mean", "vntr_mean", "cne_vntr"]
            assert rows.drop(1).collect { it.split("\t")[0] } == ["NA12718", "NA19108", "NA19235", "NA19308"]
            assert rows.drop(1).every { it.split("\t")[cne] != "NA" }

        }

    }

}

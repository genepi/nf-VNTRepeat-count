params {
    // Exones coordinates for gene´s non repetitive region (default: LPA)
    exons_coord = ["${projectDir}/assets/lpa_nonrep_exons/exons1.bed", "${projectDir}/assets/lpa_nonrep_exons/exons2.bed"]

    // Directory containing the user's BAM files — must be supplied in users config file
    bam_dir = null

//  VNTR Exones relative coordinates (default: LPA KIV-2)
    vntr_exons_coord = ["${projectDir}/assets/lpa_kiv2_exons/kiv2-1.bed", "${projectDir}/assets/lpa_kiv2_exons/kiv2-2.bed"]

    // Directory containing the user's realigned BAM files (todo: to be changed once we have a process for realignment)
    bam_dir_vntr   = null


    output_file_coverage    = 'coverage_summary.txt'
}

  outputDir         = 'results'

// todo: for now we keep profile local but we can change it in the future
process {
    executor = 'local'
    cpus     = 2
    memory   = '4 GB'
    time     = '2h'
}

profiles {

   test      {
        includeConfig 'conf/test.config'
   }

}
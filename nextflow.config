manifest {
    name            = 'nf-VNTRepeat-count'
    version         = '1.0.0'
    description     = 'Nextflow pipeline to estimate VNTR repeat count from short-read sequencing data'
    contributors    = [
        [name: 'Silvia Di Maio'],
        [name: 'Johanna F. Schachtl-Rieß'],
        [name: 'Sebastian Schönherr']
    ]
    homePage        = 'https://github.com/genepi/nf-VNTRepeat-count'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.10.0'
}

params {
    // BED files with the gene´s non-repetitive coordinates (default: LPA exons)
    nonrep_bed = ["${projectDir}/assets/lpa_nonrep_exons/nonrep-exon-1.bed", "${projectDir}/assets/lpa_nonrep_exons/nonrep-exon-2.bed"]

    // Directory containing the user's BAM files — must be supplied in users config file
    bam_dir = null

//  BED files with the VNTR coordinates, relative to the VNTR reference (default: LPA KIV-2 exons)
    vntr_bed = ["${projectDir}/assets/lpa_kiv2_exons/vntr-exon-1.bed", "${projectDir}/assets/lpa_kiv2_exons/vntr-exon-2.bed"]

    // Directory containing the user's realigned BAM files (todo: to be changed once we have a process for realignment)
    bam_dir_vntr   = null


    // Publish the coverage summary to the output directory
    save_coverage           = false

    // Normalise estimates against samples with similar coverage profiles (Mukamel et al. 2021).
    // Needs whole-exome or whole-genome BAM files in bam_dir, with an index, and many samples (> norm_neighbours).
    normalise           = false
    mosdepth_dir        = null                          // reuse <sample>.regions.bed.gz from an earlier run instead of running mosdepth
    repeats_file        = "https://hgdownload.soe.ucsc.edu/goldenPath/hg38/database/simpleRepeat.txt.gz"
    norm_neighbours     = 200                           // number of neighbours
    norm_depth_min      = 30                            // keep 1 kb windows with mean depth in [min, max]
    norm_depth_max      = 300
    norm_exclude_region = "chr6:159530000-161666000"    // gene +/- 1 Mb, excluded from windows (default: LPA, GRCh38)
}

  outputDir         = 'results'

// todo: for now we keep profile local but we can change it in the future.
// I think we can keep it for the ssh server as well and gets "ignored"
process {
    executor = 'local'
    cpus     = 2
    memory   = '4 GB'
    time     = '2h'

    withName: 'COVERAGE' {
        container = 'quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_2'
    }

    withName: 'COPY_NUMBER' {
        container = 'rocker/tidyverse:4.4.1'
    }

    withName: 'MOSDEPTH' {
        container = 'quay.io/biocontainers/mosdepth:0.3.10--h4e814b3_1'
        cpus      = 4
    }

    withName: 'NORMALISE' {
        container = 'rocker/tidyverse:4.4.1'
    }

}

profiles {

   test      {
        includeConfig 'conf/test.config'
   }

   docker {
        docker.enabled = true
        docker.runOptions = '--platform=linux/amd64'
    }

    singularity {
        singularity.enabled = true
    }
}
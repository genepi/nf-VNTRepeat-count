params {
    // Exones coordinates for gene´s non repetitive region (default: LPA)
    exons_coord = ["${projectDir}/assets/lpa_nonrep_exons/nonrep-exon-1.bed", "${projectDir}/assets/lpa_nonrep_exons/nonrep-exon-2.bed"]

    // Directory containing the user's BAM files — must be supplied in users config file
    bam_dir = null

//  VNTR Exones relative coordinates (default: LPA KIV-2)
    vntr_exons_coord = ["${projectDir}/assets/lpa_kiv2_exons/vntr-exon-1.bed", "${projectDir}/assets/lpa_kiv2_exons/vntr-exon-2.bed"]

    // Directory containing the user's realigned BAM files (todo: to be changed once we have a process for realignment)
    bam_dir_vntr   = null


    output_file_coverage    = 'coverage_summary.tsv'
}

  outputDir         = 'results'

// todo: for now we keep profile local but we can change it in the future.
// I think we can keep it for the ssh server as well and gets "ignored"
process {
    executor = 'local'
    cpus     = 2
    memory   = '4 GB'
    time     = '2h'

    withName: 'COVERAGE' {
        container = 'quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_2'
    }

    withName: 'FORMULA' {
        container = 'rocker/tidyverse:4.4.1'
    }

}

profiles {

   test      {
        includeConfig 'conf/test.config'
   }

   docker {
        docker.enabled = true
        docker.runOptions = '--platform=linux/amd64'
    }
}